---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtImage from '../../components/ArtImage.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
---

<BaseLayout
  title="Works"
  description="Three bodies of work by Natalia Afentoulidou: Life comes in circles, Your Roof, My Hut and Burn Wisdom Burn."
>
  <header class="page-head wrap">
    <div class="page-head__bar">
      <p class="eyebrow">Works / 01—03</p>
      <p class="page-head__count">Three bodies of work</p>
    </div>
    <h1>Works<span class="accent">.</span></h1>
    <div class="page-head__deck">
      <p class="lead">
        Three distinct bodies of work, each beginning from a different material condition:
        paper, discarded matter, or a whole room.
      </p>
      <p class="note">
        Each series follows its own logic. What connects them is a sustained attention to
        drawing, form, and the ways an image can occupy space.
      </p>
    </div>
  </header>

  <div class="projects-page wrap">
    <section class="projects-intro" aria-label="Introduction">
      <div class="projects-intro__grid">
        <p class="eyebrow projects-intro__aside">Three bodies<br />of work</p>
        <p class="projects-intro__copy" data-reveal>
          Each body of work follows its own material logic. A line, a wall, a roof, a title,
          another body: each series tests how an image holds together, then lets the answer
          <em>fall apart</em> and begin again.
        </p>
      </div>
    </section>

    {projects.map((project, index) => {
      const coverWork = project.works[0];
      return (
        <article class="project-entry">
          <div
            class={`project-entry__media${project.id === 'life-comes-in-circles' ? ' project-entry__media--paper' : ''}`}
            data-reveal
          >
            <a href={`/works/${project.id}`} aria-label={`View work ${project.title}`}>
              <ArtImage
                imageKey={project.cover}
                alt={coverWork.alt}
                sizes="(max-width: 900px) 100vw, 58vw"
              />
            </a>
          </div>

          <div class="project-entry__copy" data-reveal style={`--delay: ${index % 2 === 0 ? 90 : 40}ms`}>
            <div class="project-entry__meta micro">
              <span>Work {project.number}</span>
              <span>{project.category}</span>
            </div>
            <h2 class="project-entry__title">
              <a href={`/works/${project.id}`}>{project.title}</a>
            </h2>
            <p class="project-entry__tagline">{project.tagline}</p>
            <p class="project-entry__desc">{project.summary}</p>
            <a class="text-link project-entry__link" href={`/works/${project.id}`}>
              Enter work
              <Icon name="arrow-up-right" size={13} />
            </a>
          </div>
        </article>
      );
    })}
  </div>
</BaseLayout>
