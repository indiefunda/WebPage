---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtImage from '../components/ArtImage.astro';
import Icon from '../components/Icon.astro';
import { allWorks, projects } from '../data/projects';
import { lightboxAttrs } from '../lib/lightbox';
import images from '../data/images.json';

const projectById = Object.fromEntries(projects.map((project) => [project.id, project]));

const filters = [
  { id: 'all', label: 'All works' },
  ...projects.map((project) => ({
    id: project.id,
    label: project.tabTitle,
  })),
];
---

<BaseLayout
  title="Work"
  description="Selected works by Natalia Afentoulidou across drawing, installation and mixed media."
>
  <header class="page-head wrap">
    <div class="page-head__bar">
      <p class="eyebrow">Work / index</p>
      <p class="page-head__count">Selected works</p>
    </div>

    <h1 class="work-title">Work</h1>

    <div class="page-head__deck">
      <p class="lead">
        Drawings on paper, rooms built from discarded material, and images that keep moving
        between the two.
      </p>
      <p class="note">
        The index gathers selected works from the studio archive. Installation views are shown
        alongside the individual works they contain. Dimensions are listed as height × width,
        and height × width × depth for spatial works.
      </p>
    </div>
  </header>

  <div class="filter-bar">
    <div class="wrap filter-inner" role="group" aria-label="Filter works by project">
      {filters.map((filter, index) => (
        <button
          class="filter-btn"
          type="button"
          data-filter={filter.id}
          aria-pressed={index === 0 ? 'true' : 'false'}
          aria-controls="work-grid"
        >
          {filter.label}
        </button>
      ))}
      <p class="filter-count micro" data-work-count aria-live="polite">Showing 27 works</p>
    </div>
  </div>

  <section class="work-index wrap" aria-labelledby="all-works-title">
    <h2 class="sr-only" id="all-works-title">All works</h2>
    <div class="work-columns" id="work-grid" data-work-grid>
      {allWorks.map((work, index) => {
        const project = projectById[work.projectId];
        const image = images[work.image];

        return (
          <article
            class="work-item"
            id={work.id}
            data-project={work.projectId}
            data-reveal
            style={`--delay: ${(index % 3) * 70}ms`}
          >
            <a
              class="work-item__link"
              {...lightboxAttrs(work, project, image.fallback)}
            >
              <div class="work-item__media">
                <ArtImage
                  imageKey={work.image}
                  alt={work.alt}
                  sizes="(max-width: 700px) 100vw, (max-width: 1100px) 48vw, 31vw"
                  loading={index < 3 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                />
                <span class="work-item__view">View</span>
              </div>
              <div class="work-item__caption">
                <h3>{work.title}</h3>
                <p class="micro index">{String(index + 1).padStart(2, '0')}</p>
                <p class="work-item__meta">
                  {[work.medium, work.dimensions, work.year].filter(Boolean).join(' · ')}
                </p>
                <p class="work-item__project">
                  {project.number} / {project.title}
                </p>
              </div>
            </a>
          </article>
        );
      })}
    </div>

    <p class="work-empty" data-work-empty hidden>No works in this selection.</p>

    <div class="work-note">
      <span class="dot" aria-hidden="true"></span>
      <p>
        Click any image for a closer look. The viewer can be navigated with the arrow keys
        and closed with Escape.
      </p>
    </div>
  </section>

  <section class="section section--tight section--paper-deep" aria-labelledby="work-projects-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow section-index">Continue / projects</p>
        <h2 class="section-title" id="work-projects-title">The <em>rooms</em> behind the works</h2>
        <a class="text-link section-head-link" href="/projects">
          All projects
          <Icon name="arrow-up-right" size={13} />
        </a>
      </div>
      <div class="grid">
        {projects.map((project) => (
          <a
            class="text-link work-project-link"
            href={`/projects/${project.id}`}
            data-reveal
          >
            {project.number} — {project.title}
            <Icon name="arrow-up-right" size={13} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    const buttons = Array.from(document.querySelectorAll('[data-filter]'));
    const items = Array.from(document.querySelectorAll('[data-work-grid] .work-item'));
    const count = document.querySelector('[data-work-count]');
    const empty = document.querySelector('[data-work-empty]');

    const applyFilter = (filter) => {
      let visible = 0;

      items.forEach((item) => {
        const show = filter === 'all' || item.dataset.project === filter;
        item.hidden = !show;
        if (show) visible += 1;
      });

      if (count) {
        count.textContent = `Showing ${visible} ${visible === 1 ? 'work' : 'works'}`;
      }

      if (empty) empty.hidden = visible !== 0;

      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => applyFilter(button.dataset.filter));
    });
  </script>
</BaseLayout>
