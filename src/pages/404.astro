---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="not-found wrap">
    <div class="not-found__inner">
      <p class="eyebrow">404 / Elsewhere</p>
      <h1>Lost<br />{' '}<em>looking.</em></h1>
      <p>
        This page has wandered off. The work, however, is still where you left it.
      </p>
      <a class="text-link" href="/works">
        Go to the works
        <Icon name="arrow-up-right" size={13} />
      </a>
    </div>
  </section>
</BaseLayout>
